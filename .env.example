# Copy to .env and fill in. Never commit .env.
# Leave blank to run locally against the in-memory store. Fill it in to use
# Firestore, and for anything that needs a model.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
FIRESTORE_DATABASE=(default)

# Shared secret guarding every non-public route.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SAMPAN_API_KEY=

# Local development only. With no project configured the service refuses to
# start rather than quietly writing to a dictionary and reporting success.
SAMPAN_ALLOW_IN_MEMORY_STORE=true

# Models. See PRD.md 9.2 for why the Live model differs from the others.
SAMPAN_ARCHIVIST_MODEL=gemini-3.7-flash
SAMPAN_AFFECT_MODEL=gemini-3.7-flash
SAMPAN_LIVE_MODEL=gemini-live-2.5-flash-native-audio
SAMPAN_LIVE_LOCATION=us-central1

# ADK builds its own genai client from the environment, not from Settings.
GOOGLE_GENAI_USE_VERTEXAI=true

# ── Optional. Everything below is off by default and the app is complete
# ── without it. See the README for the script that provisions each one.

# Transcript screening before anything is written (scripts/setup_armor.sh).
# `dlp` calls Sensitive Data Protection directly; `armor` routes through Model
# Armor to the same templates and adds prompt-injection filters.
# SAMPAN_SCREEN_BACKEND=dlp
# SAMPAN_DLP_INSPECT_TEMPLATE=sampan-bank-only
# SAMPAN_DLP_DEIDENTIFY_TEMPLATE=sampan-bank-redact
# SAMPAN_ARMOR_TEMPLATE=sampan-transcripts

# Generated card imagery (scripts/setup_memories.sh).
# SAMPAN_MEMORIES_TOPIC=sampan-memories
# SAMPAN_MEMORIES_BUCKET=your-project-id-memories

# Quiet hours. A question left at 11pm is queued instantly and delivered in the
# morning. Setting both to the same value disables the check entirely.
# SAMPAN_TIMEZONE=Asia/Kuala_Lumpur
# SAMPAN_QUIET_FROM=22
# SAMPAN_QUIET_UNTIL=8
