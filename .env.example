# Copy to .env and fill in. Never commit .env.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
FIRESTORE_DATABASE=(default)

# Shared secret guarding every non-public route.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SAMPAN_API_KEY=

# Local development only. With no project configured the service refuses to
# start rather than quietly writing to a dictionary and reporting success.
SAMPAN_ALLOW_IN_MEMORY_STORE=true

# Models. See PRD.md 9.2 for why the Live model differs from the others.
SAMPAN_ARCHIVIST_MODEL=gemini-3.7-flash
SAMPAN_AFFECT_MODEL=gemini-3.7-flash
SAMPAN_LIVE_MODEL=gemini-live-2.5-flash-native-audio
SAMPAN_LIVE_LOCATION=us-central1

# ADK builds its own genai client from the environment, not from Settings.
GOOGLE_GENAI_USE_VERTEXAI=true
